APP_NAME=InkGroove
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR.DOMAIN
INKGROOVE_PUBLIC_PATH=/home/ACCOUNT/www/YOUR.DOMAIN/public_html

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_DATABASE
DB_USERNAME=REPLACE_USER
DB_PASSWORD="REPLACE_PASSWORD"

# File cache avoids storing temporary rate-limit and cache rows in MySQL.
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Separate secret for document seals; keep it across upgrades and in backups.
VERITAS_SIGNING_KEY=
# Images default to private storage/app/private/images, outside public_html.
